# Optional non-secret settings. Run setup.ps1 to store the API key encrypted
# for your Windows account. OPENAI_API_KEY remains supported for development
# environments, but should not be written into this file.
PORT=3199
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_VOICE=marin

# Semicolon-separated directories the assistant may list.
# If omitted, access is limited to this repository.
ASSISTANT_ALLOWED_ROOTS=
