# Optional non-secret settings for the local-first assistant.
# No paid API key is needed for the default Ollama mode.
PORT=3199
LOG_LEVEL=info
# Optional JSON log destination. The Windows launchers default to logs/assistant.log.
LOG_DESTINATION=
STT_BACKEND=faster-whisper
# Comma-separated terms to favour during Whistle recognition.
STT_KEYWORDS=Laptop Assistant,Ollama,Qwen,Notepad,Calculator
OLLAMA_KEEP_ALIVE=-1
OLLAMA_CONTEXT_SIZE=4096
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_VOICE=marin

# Semicolon-separated directories the assistant may list.
# If omitted, access is limited to this repository.
ASSISTANT_ALLOWED_ROOTS=
